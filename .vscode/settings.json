{
  "python.defaultInterpreterPath": "${env:USERPROFILE}\\rbfenv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "files.associations": {
    "*.scs": "spice",
    "*.ocn": "tcl",
    "*.il": "lisp"
  },
  "editor.rulers": [79]
}
